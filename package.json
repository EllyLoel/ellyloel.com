{
	"name": "ellyloel.com",
	"description": "This is my own lovely little corner of the internet. Look forward to plenty of interesting ideas & projects.",
	"version": "4.0.0",
	"license": "MIT",
	"type": "module",
	"author": {
		"name": "Elly Loel",
		"email": "hello@ellyloel.com",
		"url": "https://ellyloel.com/"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/ellyloel/ellyloel.com.git"
	},
	"bugs": {
		"url": "https://github.com/ellyloel/ellyloel.com/issues"
	},
	"scripts": {
		"start": "ELEVENTY_ENV=development eleventy --serve --incremental --quiet",
		"build": "pnpm bookmarks && ELEVENTY_ENV=production pnpm build:eleventy && pnpm build:pagefind",
		"build:local": "pnpm bookmarks && ELEVENTY_ENV=development pnpm build:eleventy && pnpm build:pagefind",
		"build:eleventy": "eleventy --quiet",
		"build:pagefind": "pagefind --site _site",
		"start:pagefind": "pagefind --site _site --serve",
		"start:debug": "ELEVENTY_ENV=development DEBUG=Eleventy* eleventy --serve --incremental",
		"build:debug": "DEBUG=Eleventy* eleventy",
		"build:benchmark": "DEBUG=Eleventy:Benchmark* eleventy",
		"postId": "./scripts/postId.js -a -d=./src/input/content/garden/",
		"bookmarks": "./scripts/bookmarks.js",
		"lint:css": "stylelint \"src/input/css/**/*.css\"",
		"lint:css:fix": "stylelint \"src/input/css/**/*.css\" --fix",
		"lint:js": "eslint src/input/js/",
		"lint:js:fix": "eslint src/input/js/ --fix",
		"postbuild": "webmention _site/feed.atom --limit 10 --send"
	},
	"packageManager": "pnpm@12.15.0",
	"dependencies": {
		"@11ty/eleventy": "^3.1.7",
		"@11ty/is-land": "^5.0.1",
		"@google/model-viewer": "^4.4.0",
		"@remy/webmention": "^1.5.0",
		"@terriblemia/eight-ball": "^0.2.0",
		"@zachleat/details-utils": "^3.0.0",
		"canvas-confetti": "^1.9.4",
		"color-elements": "^0.0.14",
		"css-doodle": "0.65.0",
		"d3": "^7.9.0",
		"dompurify": "^3.4.17",
		"howler": "^2.2.4",
		"octokit": "^5.0.5",
		"pagefind": "^1.5.2",
		"three": "^0.186.1"
	},
	"devDependencies": {
		"@11ty/eleventy-fetch": "^6.0.1",
		"@11ty/eleventy-img": "^7.1.1",
		"@11ty/eleventy-navigation": "^1.0.5",
		"@11ty/eleventy-plugin-rss": "^3.1.0",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"@eslint/js": "^10.0.1",
		"@fortawesome/fontawesome-free": "^7.3.1",
		"@photogabble/eleventy-plugin-interlinker": "^1.1.2",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.2",
		"@sindresorhus/slugify": "^3.0.1",
		"@types/eslint": "^9.6.1",
		"@types/markdown-it": "^14.2.0",
		"browserslist": "^4.29.4",
		"cssnano": "^9.9.0",
		"cssremedy": "0.1.0-beta.2",
		"dotenv": "^18.0.9",
		"eleventy-plugin-emoji": "^1.1.0",
		"eleventy-plugin-gen-favicons": "^1.1.3",
		"eleventy-plugin-icons": "^4.6.0",
		"eleventy-plugin-rollup": "^1.3.0",
		"eleventy-plugin-toc": "^1.1.5",
		"eleventy-plugin-webmentions": "^2.1.0",
		"eslint": "^10.13.0",
		"globals": "^17.13.0",
		"html-minifier": "^4.0.0",
		"js-yaml": "^5.5.0",
		"jsdom": "^30.1.3",
		"markdown-it": "^15.0.3",
		"markdown-it-abbr": "^2.0.0",
		"markdown-it-anchor": "^10.0.0",
		"markdown-it-attribution": "^0.1.4",
		"markdown-it-attrs": "^5.0.1",
		"markdown-it-container": "^4.0.0",
		"markdown-it-footnote": "^4.0.0",
		"markdown-it-ins-del": "^0.1.1",
		"markdown-it-mark": "^4.0.0",
		"markdown-it-sup": "^2.0.0",
		"markdown-it-wikilinks": "^1.4.0",
		"open-props": "^1.7.23",
		"postcss": "^8.5.31",
		"postcss-import": "^17.0.1",
		"postcss-jit-props": "^1.0.16",
		"postcss-load-config": "^6.0.1",
		"postcss-preset-env": "^11.6.1",
		"remove-markdown": "^0.8.0",
		"rollup": "^4.65.0",
		"rss-parser": "^3.13.0",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-gamut": "^2.0.1",
		"stylelint-order": "^8.1.2",
		"wrangler": "^4.152.0"
	},
	"browserslist": [
		"defaults"
	]
}
